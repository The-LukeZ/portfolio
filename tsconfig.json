{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "sourceMap": true,
    "strict": true,
    "types": ["$app/types", "./src/worker-configuration.d.ts"]
  },
  "include": ["src", "vite.config.ts"],
  // Generated Paraglide output ships .d.ts files; don't type-check its JS
  "exclude": ["src/lib/paraglide"]
}

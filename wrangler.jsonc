/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "account_id": "92d72ac72fb811275ce6e8d5263a9816",
  "main": "src/worker.ts",
  // The SvelteKit build output, imported by src/worker.ts (custom entry for the cron trigger).
  "alias": { "sveltekit-worker": "./.svelte-kit/cloudflare/_worker.js" },
  "compatibility_date": "2026-07-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare",
  },
  "preview_urls": false,
  "d1_databases": [
    {
      // Feed state: Discord announcements and post likes (migrations/).
      "binding": "FEED_DB",
      "database_name": "portfolio-feed",
      "database_id": "cd952de0-c546-4449-bd45-d1cfbb3cbed3",
      "migrations_dir": "migrations",
    },
  ],
  // Announces newly published feed posts to Discord.
  "triggers": { "crons": ["*/5 * * * *"] },
  // Public Turnstile site key for the feed like button (widget for thelukez.com). .env overrides it locally with the test key.
  "vars": { "TURNSTILE_SITE_KEY": "REPLACE_WITH_PRODUCTION_SITE_KEY" },
  "secrets": {
    "required": [
      "DISCORD_WEBHOOK_URL",
      "GITHUB_CLIENT_ID",
      "GITHUB_CLIENT_SECRET",
      "LIKE_SECRET",
      "TURNSTILE_SECRET_KEY",
    ],
  },
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "route": {
    "custom_domain": true,
    "pattern": "thelukez.com",
  },
}

# Worker secrets for local dev (wrangler dev and vite dev read .env). Production: `pnpm wrangler secret put <NAME>`.
DISCORD_WEBHOOK_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Signs feed like device cookies and hashes IPs. Any long random string, e.g. `openssl rand -base64 32`.
LIKE_SECRET=
# Cloudflare Turnstile test keys (always pass). Production site key lives in wrangler.jsonc vars.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
